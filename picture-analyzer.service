[Unit]
Description=Picture Analyzer admin/API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leen
Group=leen
WorkingDirectory=/home/leen/projects/pictures
ExecStart=/home/leen/projects/pictures/.venv/bin/python api.py --port 7000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
